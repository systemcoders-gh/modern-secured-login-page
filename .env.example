# Copy to .env for local overrides. Never commit the real .env.
APP_ENV=development
DJANGO_DEBUG=false
APP_ORIGIN=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Development creates ignored local random keys automatically.
# Production: generate unique values using docs/deployment.md; no sample secrets.
DJANGO_SECRET_KEY=
MFA_ENCRYPTION_KEYS=
DATABASE_URL=
REDIS_URL=
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=System Coders <noreply@localhost>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
TRUST_PROXY_HTTPS=false
ALLAUTH_TRUSTED_PROXY_COUNT=0
# Opt in only after confirming HTTPS for all subdomains and preload commitment.
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
